# Copy this file to .env and replace placeholders when configuration is needed.
APP_ENV=development
# Local default: sqlite:///database/ai_daily_radar.db
# Production: postgresql://username:password@hostname:5432/ai_daily_radar
DATABASE_URL=sqlite:///database/ai_daily_radar.db
AI_API_KEY=your_ai_api_key_here
# A long, random value used to sign login sessions in production.
SESSION_SECRET=replace_with_a_long_random_secret
